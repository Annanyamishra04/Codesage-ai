# ==============================================
# CodeSage AI — Environment Variables
# ==============================================
#
# REQUIRED variables must be set for the app to start.
# OPTIONAL variables have sensible defaults and can be left unset.

# --- Database (REQUIRED) ---
# Any Postgres provider compatible with Prisma works; Neon's free tier is
# recommended (see README → Free Deployment).
# Pooled connection string, used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (unpooled) connection string, used by Prisma Migrate.
# On Neon, this is your connection string with "-pooler" removed from the host.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# --- Authentication ---
# No additional secret is required. Sessions are random tokens stored
# (hashed) in your own database via Prisma, not signed JWTs, so there is no
# session secret to configure. Passwords are hashed with bcrypt.

# --- AI Provider Configuration (OPTIONAL) ---
# One of: mock | openai | anthropic
# "mock" requires no API key and generates realistic demo reviews locally —
# the app is fully usable (including sign-up, code review, and the
# plagiarism checker) without ever setting an AI_API_KEY.
AI_PROVIDER=mock

# Required only when AI_PROVIDER is "openai" or "anthropic".
AI_API_KEY=

# Model name for the selected provider.
# openai examples:    gpt-4o-mini, gpt-4o
# anthropic examples: claude-sonnet-4-6, claude-haiku-4-5-20251001
AI_MODEL=gpt-4o-mini

# Optional: override the API base URL to use an OpenAI-compatible endpoint
# (OpenRouter, Groq, Together AI, a local server, etc). Only used when
# AI_PROVIDER=openai.
# AI_BASE_URL=https://openrouter.ai/api/v1

# --- GitHub repository link (OPTIONAL) ---
# Public URL to this project's source repository, shown as the "View source"
# link in the landing page footer. This is a NEXT_PUBLIC_ variable, so it is
# exposed to the browser — do not put anything sensitive here.
# If left unset, the link is hidden/disabled rather than pointing at a
# generic, unrelated GitHub URL.
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/codesage-ai
